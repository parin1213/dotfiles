# herdr の設定。chezmoi が正本なので、直接編集せず source を直して chezmoi apply する。
# source は template（OS で中身が変わる）なので、差分の取り込みに chezmoi add は使えない。
# herdr 自身もこのファイルを書き換える（初回の onboarding、`herdr config reset-keys`）。
# herdr が書いた分を残したいときは、実体の差分を見て source の template を手で直す。

onboarding = false
{{ if eq .chezmoi.os "windows" }}
# Windows の既定シェルは PowerShell 5.1。zoxide / starship / eza を仕込んでいるのは
# pwsh 7 のプロファイル（Documents/PowerShell/）なので、ペインも pwsh で開く。
[terminal]
default_shell = "pwsh"
{{ end }}
[theme]
name = "tokyo-night"
auto_switch = false

# レート上限はアカウント単位なので、ペインを何枚開いても数字は 1 つ。
# ペイン単位のサイドバーに出すと同じ値が並ぶだけなので、セッションに 1 つしかない右端に置く。
# herdr-rate-limit は PATH から解決する（Windows は同名の .cmd が拾われる）。
# 中身は Claude Code の statusLine が書く ~/.claude/cache/rate-limit.json を読むだけ。
[ui]
tab_bar_right = [
  { type = "command", command = "herdr-rate-limit", interval_seconds = 60, timeout_seconds = 5 },
]

[ui.toast]
delivery = "off"

# エージェントの状態遷移で鳴らす。背景ワークスペースだけが対象なので、
# 見ているペインでは鳴らない。音声は VOICEVOX ずんだもんを mp3 に焼いたもの。
[ui.sound]
enabled = true
done_path = "sounds/zundamon-done.mp3"
request_path = "sounds/zundamon-request.mp3"

# Agents 一覧は既定だと machine / workspace（＝ディレクトリ名）が先に来て、
# 何の話をしているかが読めない。Claude のペインは会話のタイトルを 1 行目に出し、
# どこで作業しているかは 2 行目に下げる。machine は 1 台しかないので出さない。
[ui.sidebar.agents]
rows = [["state_icon", "workspace"], ["agent"]]

[ui.sidebar.agents.rows_by_agent]
claude = [
  ["state_icon", { token = "terminal_title_stripped", fg = "#7dcfff", bold = true }],
  [{ token = "workspace", fg = "#565f89", dim = true }, { token = "tab", fg = "#565f89", dim = true }],
]

# Spaces 一覧はラベルがディレクトリ名なので、同じリポジトリのワークスペースが並ぶと
# 見分けがつかない。いま何の話をしているかを $topic（herdr-tab-title が報告）で先に出し、
# 場所と git の状態は 2 行目へ下げる。
[ui.sidebar.spaces]
rows = [
  ["state_icon", { token = "$topic", fg = "#7dcfff", bold = true }],
  [{ token = "workspace", fg = "#565f89", dim = true }, { token = "branch", fg = "#565f89", dim = true }, "git_status"],
]
