{{- /*
  Obsidian vault 自動同期の launchd / systemd 登録ブリッジ。
  mac または linux かつ vault_sync のときのみ。他は空レンダ→skip。
  各定義ファイルのハッシュを埋めてあるので、定義を変えた apply のときだけ再実行される。
  macの定義は Library/LaunchAgents/com.parin1213.obsidian-vault-sync.plist.tmpl。
  linuxの定義は dot_config/systemd/user/obsidian-vault-sync.{service,timer}.tmpl。
*/ -}}
{{- $p := includeTemplate "profile" . | fromJson -}}
{{- if and (eq .chezmoi.os "darwin") $p.vault_sync -}}
#!/bin/sh
# plist hash: {{ include "Library/LaunchAgents/com.parin1213.obsidian-vault-sync.plist.tmpl" | sha256sum }}
set -eu
LABEL="com.parin1213.obsidian-vault-sync"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
UID_NUM=$(id -u)
launchctl bootout "gui/$UID_NUM/$LABEL" >/dev/null 2>&1 || true
launchctl bootstrap "gui/$UID_NUM" "$PLIST"
echo "==> launchd registered: $LABEL"
{{- else if and (eq .chezmoi.os "linux") $p.vault_sync -}}
#!/bin/sh
# service hash: {{ include "dot_config/systemd/user/obsidian-vault-sync.service.tmpl" | sha256sum }}
# timer hash: {{ include "dot_config/systemd/user/obsidian-vault-sync.timer.tmpl" | sha256sum }}
set -eu
systemctl --user daemon-reload
systemctl --user enable --now obsidian-vault-sync.timer
systemctl --user is-active --quiet obsidian-vault-sync.timer
echo "==> Obsidian vault: 5分間隔の同期タイマーを登録しました"
{{- end }}
