{{- /*
  Codex グローバル設定の標準化ブリッジ（Windows のみ。Unix は .sh 版が担当）。
  Codex は config.toml に runtime 状態を自分で書き込むため丸ごと管理は drift する。
  tomlkit で「標準グローバルキーだけ」上書きし runtime 状態は温存（mise-install と同思想）。
  run_onchange はスクリプト内容が変わった時だけ再実行 → 標準値を変えた apply のときだけ走る。
  codex 未導入なら何もしない。Windows は [windows] sandbox=elevated も設定する。
  check_for_update_on_startup=false: 更新は日次の pkg-update（mise up）が担うので、起動のたびに聞かれると作業が止まる。
  projects.<home> を信頼済みにする: Stream Deck から herdr の Space をホームで開くたびに「このフォルダを信頼するか」で止まらないため。
  hooks.json: Codex の会話にも herdr のタブ名・Spaces の topic を付ける（herdr-topic.mjs）。cmux や herdr もそれぞれ項目を
  書き足すので、丸ごと管理せず自分の項目が無いときだけ足す。
  本文は ASCII のみ。PowerShell 5.1 が非 ASCII を python の stdin へ渡す途中で化けさせ、コメントの改行ごと壊すため。
*/ -}}
{{ if eq .chezmoi.os "windows" -}}
# codex standard v4
$env:Path = "$env:LOCALAPPDATA\mise\shims;$env:Path"
if (-not (Get-Command codex -ErrorAction SilentlyContinue)) { exit 0 }
$py = (Get-Command python -ErrorAction SilentlyContinue).Source
if (-not $py) { Write-Host "python not found, skip codex standardization"; exit 0 }
& $py -m pip install --user --quiet tomlkit *> $null
$code = @'
import tomlkit, pathlib
p = pathlib.Path.home() / ".codex" / "config.toml"
doc = tomlkit.parse(p.read_text(encoding="utf-8")) if p.exists() else tomlkit.document()
doc["model"] = "gpt-5.5"
doc["model_reasoning_effort"] = "high"
doc["personality"] = "pragmatic"
doc["check_for_update_on_startup"] = False
tui = doc.get("tui")
if tui is None:
    tui = tomlkit.table(); doc["tui"] = tui
tui["status_line"] = ["model", "current-dir", "git-branch", "context-used", "five-hour-limit", "weekly-limit"]
plugins = doc.get("plugins")
if plugins is None:
    plugins = tomlkit.table(); doc["plugins"] = plugins
for name in ["github@openai-curated", "gmail@openai-curated", "google-calendar@openai-curated", "notion@openai-curated"]:
    t = plugins.get(name)
    if t is None:
        t = tomlkit.table(); plugins[name] = t
    t["enabled"] = True
win = doc.get("windows")
if win is None:
    win = tomlkit.table(); doc["windows"] = win
win["sandbox"] = "elevated"
projects = doc.get("projects")
if projects is None:
    projects = tomlkit.table(); doc["projects"] = projects
home = str(pathlib.Path.home())
proj = projects.get(home)
if proj is None:
    proj = tomlkit.table(); projects[home] = proj
proj["trust_level"] = "trusted"
features = doc.get("features")
if features is None:
    features = tomlkit.table(); doc["features"] = features
features["hooks"] = True
import json
hp = pathlib.Path.home() / ".codex" / "hooks.json"
hooks = json.loads(hp.read_text(encoding="utf-8")) if hp.exists() else {}
events = hooks.setdefault("hooks", {})
topic_cmd = "node " + (pathlib.Path.home() / ".local" / "bin" / "herdr-topic.mjs").as_posix() + " --codex"
for ev in ("SessionStart", "Stop"):
    groups = events.setdefault(ev, [])
    if not any("herdr-topic.mjs" in h.get("command", "") for g in groups for h in g.get("hooks", [])):
        groups.append({"hooks": [{"type": "command", "command": topic_cmd, "timeout": 10}]})
hp.parent.mkdir(parents=True, exist_ok=True)
hp.write_text(json.dumps(hooks, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
p.parent.mkdir(parents=True, exist_ok=True)
p.write_text(tomlkit.dumps(doc), encoding="utf-8")
print("codex: standard global settings merged (runtime state preserved)")
'@
$code | & $py -
{{ end -}}
