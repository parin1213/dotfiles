{
  "model": "opus",
{{- if ne .chezmoi.os "windows" }}
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "{{ .chezmoi.homeDir }}/.local/bin/herdr-tab-title working" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "{{ .chezmoi.homeDir }}/.local/bin/herdr-tab-title working" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "{{ .chezmoi.homeDir }}/.local/bin/herdr-tab-title waiting" }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "{{ .chezmoi.homeDir }}/.local/bin/herdr-tab-title attention" }] }
    ]
  },
{{- end }}
  "permissions": {
    "allow": [
      "Bash(bin/rails --version)",
      "Bash(bin/rails generate:*)",
      "Bash(bin/rails db:create db:migrate)",
      "Bash(bin/rails server:*)",
      "Bash(bin/rails routes:*)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
{{- if eq .chezmoi.os "windows" }}
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File {{ .chezmoi.homeDir | replace "\\" "/" }}/.claude/statusline.ps1"
{{- else }}
    "command": "{{ .chezmoi.homeDir }}/.claude/statusline.sh"
{{- end }}
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "concise@concise": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "cc-plugin-you-should-know@builtin": true,
    "claude-md-management@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "concise": {
      "source": {
        "source": "github",
        "repo": "kmizu/concise"
      }
    }
  },
  "effortLevel": "high",
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "tui": "fullscreen",
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true
}
