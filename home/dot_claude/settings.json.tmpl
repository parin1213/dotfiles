{
{{- /* herdr のタブ名と Spaces の $topic を更新する hook。Windows は .ps1 を powershell 経由で呼ぶ。名前は引数で変わらないので async で順序が入れ替わっても困らない。 */ -}}
{{- $tabTitle := printf "%s/.local/bin/herdr-tab-title" .chezmoi.homeDir }}
{{- if eq .chezmoi.os "windows" }}
{{-   $tabTitle = printf "powershell -NoProfile -ExecutionPolicy Bypass -File %s/.local/bin/herdr-tab-title.ps1" (.chezmoi.homeDir | replace "\\" "/") }}
{{- end }}
{{- /* 会話から今の話題のタイトルを作る hook。Haiku を裏で呼ぶので hook 自体はすぐ戻る。 */ -}}
{{- $topic := printf "node %s/.local/bin/herdr-topic.mjs" (.chezmoi.homeDir | replace "\\" "/") }}
  "model": "opus",
{{- /* 会話ログを日数で消さず、過去のセッションをいつでも読み返せるようにする。 */}}
  "cleanupPeriodDays": 36500,
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "{{ $tabTitle }} working", "async": true }] },
      { "hooks": [{ "type": "command", "command": "{{ $topic }}" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "{{ $tabTitle }} working", "async": true }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "{{ $tabTitle }} waiting", "async": true }] },
      { "hooks": [{ "type": "command", "command": "{{ $topic }}" }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "{{ $tabTitle }} attention", "async": true }] }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bin/rails --version)",
      "Bash(bin/rails generate:*)",
      "Bash(bin/rails db:create db:migrate)",
      "Bash(bin/rails server:*)",
      "Bash(bin/rails routes:*)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
{{- if eq .chezmoi.os "windows" }}
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File {{ .chezmoi.homeDir | replace "\\" "/" }}/.claude/statusline.ps1"
{{- else }}
    "command": "{{ .chezmoi.homeDir }}/.claude/statusline.sh"
{{- end }}
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "concise@concise": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "cc-plugin-you-should-know@builtin": true,
    "claude-md-management@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "concise": {
      "source": {
        "source": "github",
        "repo": "kmizu/concise"
      }
    }
  },
  "effortLevel": "high",
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "tui": "fullscreen",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true
}
