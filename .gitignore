.DS_Store
*.swp
*.backup-*

# リポジトリ直下のローカル mise.toml（`mise use` が生成するプロジェクト固有設定）。
# dotfiles の mise 設定は home/dot_config/mise/config.toml.tmpl が正本なので追跡しない。
/mise.toml

# 自走作業の再開メモは各マシンの実行状態を含むため共有しない。
/STATE.md

# 野良スキルの検収用 staging（採用したものだけ skills/ に移して追跡する）。
/skills-staging/

# global gitignore (~/.gitignore_global) が .claude/ を除外しているが、
# このリポでは Claude Code のグローバル設定を管理するので上書きする
!home/.claude/
!home/.claude/**

# クレデンシャルファイルの誤 add 防止（後勝ちで .claude/** 再追跡より優先）。
# chezmoi は明示 add したファイルしか管理しないが、念のための多層防御。
*.pem
*.key
id_rsa*
.netrc
*.credentials.json
**/auth.json
**/hosts.yml

# Stream Deck の生成物（gen-profiles.mjs / make-icons.ps1 / make-icons-mac.sh の出力）
/streamdeck/out/
# ゲームとアプリのアイコンは各社のロゴ・画像なので公開リポジトリに入れない。make-icons.ps1 / make-icons-mac.sh が手元のアプリや公式サイトから作る
/streamdeck/icons/genshin.png
/streamdeck/icons/hsr.png
/streamdeck/icons/obsidian.png
/streamdeck/icons/youtube-music.png
/streamdeck/icons/codex-app.png
/streamdeck/icons/terminal.png
/streamdeck/icons/vscode.png
/streamdeck/icons/claude-code.png
/streamdeck/icons/codex-cli.png
/streamdeck/icons/github-pr.png
/streamdeck/icons/slack.png
/streamdeck/icons/chatgpt.png
/streamdeck/icons/ghostty.png
/streamdeck/icons/google-drive.png
/streamdeck/icons/google-calendar.png
/streamdeck/icons/notion.png
/streamdeck/icons/badges/
# 自作プラグインのビルド結果と依存（pnpm build で作る）
/streamdeck/plugin/node_modules/
/streamdeck/plugin/io.github.parin1213.desk.sdPlugin/bin/
/streamdeck/plugin/io.github.parin1213.desk.sdPlugin/imgs/keys/
/streamdeck/plugin/io.github.parin1213.desk.sdPlugin/logs/
/streamdeck/plugin/io.github.parin1213.desk.sdPlugin/profiles/
