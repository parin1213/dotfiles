{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "io.github.parin1213.desk",
  "Name": "Desk",
  "Version": "0.1.0.0",
  "Author": "parin1213",
  "Description": "herdr の Space と Claude Code / Codex の使用率を出し、アプリの未読数・コマンド実行・PC⇄Mac の入力切り替え・経過時間を扱う自作プラグイン",
  "Icon": "imgs/plugin",
  "Category": "Desk",
  "CategoryIcon": "imgs/category",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": { "MinimumVersion": "7.6" },
  "Nodejs": { "Version": "24" },
  "OS": [
    { "Platform": "windows", "MinimumVersion": "10" },
    { "Platform": "mac", "MinimumVersion": "13" }
  ],
  "Actions": [
    {
      "UUID": "io.github.parin1213.desk.infobar",
      "Name": "使用率（Infobar）",
      "Tooltip": "Claude Code と Codex の 5 時間 / 7 日の使用率。承認待ちの Space があるとその表示に切り替わる",
      "Icon": "imgs/actions/infobar",
      "Controllers": ["Neo"],
      "States": [{ "Image": "imgs/actions/infobar" }]
    },
    {
      "UUID": "io.github.parin1213.desk.space",
      "Name": "herdr Space",
      "Tooltip": "herdr の Space の状態と話題。押すとその Space に移る。何番目の Space かは置いた列で決まる",
      "Icon": "imgs/actions/space",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "States": [{ "Image": "imgs/keys/space", "ShowTitle": false }]
    },
    {
      "UUID": "io.github.parin1213.desk.claude-5h",
      "Name": "Claude 5 時間",
      "Tooltip": "Claude Code の 5 時間枠の使用率とリセット時刻",
      "Icon": "imgs/actions/limit",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "States": [{ "Image": "imgs/keys/claude-5h", "ShowTitle": false }]
    },
    {
      "UUID": "io.github.parin1213.desk.claude-7d",
      "Name": "Claude 7 日",
      "Tooltip": "Claude Code の 7 日枠の使用率とリセット日時",
      "Icon": "imgs/actions/limit",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "States": [{ "Image": "imgs/keys/claude-7d", "ShowTitle": false }]
    },
    {
      "UUID": "io.github.parin1213.desk.timer",
      "Name": "経過時間",
      "Tooltip": "押すと 0 から数え直す。長押しで止める",
      "Icon": "imgs/actions/timer",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "States": [{ "Image": "imgs/keys/timer", "ShowTitle": false }]
    },
    {
      "UUID": "io.github.parin1213.desk.switch-input",
      "Name": "PC ⇄ Mac",
      "Tooltip": "Dell の入力を DDC/CI で切り替えて、こちらの画面をロックする。PC では Mac（Thunderbolt 4）に、Mac では PC（DisplayPort）にする",
      "Icon": "imgs/actions/switch",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "States": [{ "Image": "imgs/keys/switch", "ShowTitle": false }]
    },
    {
      "UUID": "io.github.parin1213.desk.app",
      "Name": "アプリ（未読数）",
      "Tooltip": "押すとアプリを開く。Mac では Dock のバッジ（未読数）をキーの右上に出す",
      "Icon": "imgs/actions/app",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "States": [{ "Image": "imgs/actions/app", "ShowTitle": false }]
    },
    {
      "UUID": "io.github.parin1213.desk.run",
      "Name": "コマンド実行",
      "Tooltip": "設定の cmd と args でコマンドを実行する。Mac の標準の「開く」は引数付きのコマンドを走らせられないため",
      "Icon": "imgs/actions/run",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "States": [{ "Image": "imgs/actions/run", "ShowTitle": false }]
    },
    {
      "UUID": "io.github.parin1213.desk.page",
      "Name": "ページ",
      "Tooltip": "今のページ番号を出し、押すと 1 ページ目に戻る。別のページに承認待ちや Slack のメンションがあれば、そのページへ飛ぶ。終わった Space と Slack の未読チャンネルは上に小さく出す。同梱のプロファイルでだけ動く",
      "Icon": "imgs/actions/run",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "VisibleInActionsList": false,
      "States": [{ "Image": "imgs/keys/page", "ShowTitle": false }]
    }
  ],
  "Profiles": [
    { "Name": "profiles/normal", "DeviceType": 9, "DontAutoSwitchWhenInstalled": true },
    { "Name": "profiles/terminal", "DeviceType": 9, "DontAutoSwitchWhenInstalled": true },
    { "Name": "profiles/vscode", "DeviceType": 9, "DontAutoSwitchWhenInstalled": true }
  ]
}
